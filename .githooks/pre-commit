#!/bin/sh
# ATLS pre-commit hook
# Runs: frontend lint-staged (JS/JSX files) + backend ruff (Python files)

echo "🔍 Running pre-commit checks..."

# ─── Frontend: lint-staged (only if JS/JSX files are staged) ───────────────
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "\.(js|jsx)$" || true)

if [ -n "$STAGED_JS" ]; then
  echo "⚛️  Frontend: running ESLint + Prettier on staged files..."
  cd Front-End && npx lint-staged
  LINT_EXIT=$?
  cd ..
  if [ $LINT_EXIT -ne 0 ]; then
    echo "❌ Frontend lint failed. Fix errors before committing."
    exit 1
  fi
  echo "✅ Frontend lint passed."
fi

# ─── Backend: ruff (only if Python files are staged) ───────────────────────
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "\.py$" || true)

if [ -n "$STAGED_PY" ]; then
  echo "🐍 Backend: running ruff on staged Python files..."
  echo "$STAGED_PY" | xargs Back-End/venv/Scripts/ruff check --fix
  RUFF_EXIT=$?
  if [ $RUFF_EXIT -ne 0 ]; then
    echo "❌ Backend ruff check failed. Fix errors before committing."
    exit 1
  fi
  # Re-stage any ruff auto-fixes
  echo "$STAGED_PY" | xargs git add
  echo "✅ Backend ruff passed."
fi

echo "✅ All pre-commit checks passed."
exit 0
